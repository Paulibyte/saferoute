# Copy to .env and edit. The first admin account is created from these on the first start.
PORT=3060
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
# Set to true once the site is served over HTTPS (it will be, behind Nginx + certbot)
COOKIE_SECURE=true
# The public address of the app, used in SMS and live-location links
PUBLIC_URL=https://saferoute.jobtins.com

# --- SMS for SOS alerts (optional). Without these, SOS still alerts responders' devices,
# --- and the user can text their circle from their own phone with one tap.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx              (or use a Messaging Service instead:)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Automated voice calls when an SOS is not acknowledged (needs TWILIO_FROM to be a voice-capable number)
# TWILIO_VOICE=true

# --- Staff accounts (admin, moderator, verified security) must use two-step verification. Set to false only for testing.
# REQUIRE_STAFF_MFA=true
# Optional: your own long random secret used to encrypt two-step keys stored in the database
# APP_SECRET=put-a-long-random-string-here

# --- Route service (optional). Default is the free public OSRM demo server, fine for testing and light use.
# ROUTER_URL=https://router.project-osrm.org

# Optional: where the database file and uploaded media live (default: ./data)
# DATA_DIR=/var/www/saferoute/data
